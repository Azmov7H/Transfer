# Jammaz-System frontend — environment configuration
# Copy to .env.local and fill in values. Never commit real .env files.

# Secret used by src/middleware.js to verify the auth JWT (HS256).
# Required in every environment. Must match the backend's signing secret.
JWT_SECRET=<generate-with: openssl rand -base64 48>

# Backend origin that /api/* requests are proxied to (next.config.mjs rewrites).
# Development: http://127.0.0.1:5000
# Docker production-local: http://backend:5000
API_PROXY_TARGET=http://127.0.0.1:5000

# Optional absolute API base URL used by src/lib/api-utils.js.
# Leave empty for same-origin requests through the Next.js proxy (default).
# DO NOT set this to a cross-origin backend: the auth cookie would be set on
# the API's origin and middleware would never see it (login redirect loop).
NEXT_PUBLIC_API_URL=

# --- Production-Like Local (Docker) ---
# For the Docker-based production-like environment, use .env.production-local
# which is pre-configured with container hostnames.
# Start with: docker compose -f docker-compose.production-local.yml up -d --build
