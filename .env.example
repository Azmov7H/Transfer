# Jammaz-System frontend — environment configuration
# Copy to .env.local and fill in values. Never commit real .env files.

# Secret used by src/middleware.js to verify the auth JWT (HS256).
# Required in every environment. Must match the backend's signing secret.
JWT_SECRET=

# Backend origin that /api/* requests are proxied to (next.config.mjs rewrites).
API_PROXY_TARGET=http://127.0.0.1:5050

# Optional absolute API base URL used by src/lib/api-utils.js.
# Leave empty for same-origin requests through the Next.js proxy (default).
NEXT_PUBLIC_API_URL=
